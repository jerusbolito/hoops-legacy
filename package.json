{
  "name": "hoops-legacy",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "A basketball career RPG with an AI narrator.",
  "author": "Jerus Bolito",
  "main": "desktop/dist/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit && tsc -p desktop/tsconfig.json --noEmit",
    "desktop:build": "vite build && node scripts/build-desktop.mjs",
    "desktop": "npm run desktop:build && node scripts/run-electron.mjs",
    "desktop:smoke": "npm run desktop:build && node scripts/run-electron.mjs --smoke",
    "desktop:pack": "node scripts/pack.mjs --dir",
    "desktop:dist": "node scripts/pack.mjs",
    "icon": "node scripts/make-icon.mjs",
    "desktop:engine": "node scripts/fetch-engine.mjs",
    "desktop:model": "node scripts/fetch-model.mjs",
    "desktop:dist:full": "node scripts/pack.mjs --full"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "dexie": "^4.0.11",
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.0.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
